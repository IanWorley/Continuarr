{
  "name": "continuarr",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev",
    "generate-routes": "tsr generate",
    "build": "vite build",
