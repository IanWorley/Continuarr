          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/SetupRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Admin created"
          },
          "400" : {
            "description" : "Blank username or password length out of range"
          },
          "403" : {
            "description" : "Wrong setup token"
          },
          "409" : {
            "description" : "An admin already exists"
          }
        }
      }
    },
    "/api/v1/auth" : {
      "get" : {
        "tags" : [ "session-controller" ],
        "operationId" : "session",
        "responses" : {
