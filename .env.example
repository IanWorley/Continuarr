# Copy to .env and fill in. .env is gitignored; never commit real values.

POSTGRES_DB=continuarr
POSTGRES_USER=continuarr
POSTGRES_PASSWORD=change-me

# No admin credentials here: on first start the app logs a one-time setup token
# (`docker compose logs app`), which POST /api/setup uses to create the admin.

# Host port for the app.
CONTINUARR_PORT=8080

# Your Jellyfin server, reachable from inside the app container, and an API key from
# Jellyfin's Dashboard > API Keys. Until you replace them, the app starts and logs that it
# can't reach Jellyfin.
CONTINUARR_JELLYFIN_URL=http://jellyfin:8096
CONTINUARR_JELLYFIN_API_KEY=replace-with-your-jellyfin-api-key
