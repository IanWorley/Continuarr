# Copy to .env and fill in. .env is gitignored; never commit real values.

POSTGRES_DB=continuarr
POSTGRES_USER=continuarr
POSTGRES_PASSWORD=change-me

CONTINUARR_ADMIN_USERNAME=admin
# Bcrypt hash of the admin password. Keep the single quotes: bcrypt hashes
# contain `$`, and without them Compose expands `$2a`, `$10`, ... and silently
# mangles the hash, so every login fails. Generate one with:
#   htpasswd -nbBC 10 "" 'your-password' | cut -d: -f2
CONTINUARR_ADMIN_PASSWORD_HASH='$2y$10$replace.with.your.own.bcrypt.hash.................'

# Host port for the app.
CONTINUARR_PORT=8080
