              "schema" : {
                "$ref" : "#/components/schemas/JellyfinConnectionRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "204" : {
            "description" : "Saved; the next Jellyfin call uses it"
          },
          "400" : {
            "description" : "Names the invalid fields without echoing their values",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/JellyfinConnectionProblem"
                }
              }
            }
          },
          "503" : {
            "description" : "CONTINUARR_ENCRYPTION_KEY isn't set, so the API key can't be stored"
          }
        }
      }
    },
    "/api/setup" : {
      "get" : {
        "tags" : [ "setup-controller" ],
        "operationId" : "setupStatus",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SetupStatus"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "setup-controller" ],
