          },
          "username" : {
            "type" : "string"
          },
          "password" : {
            "type" : "string"
          }
        },
        "required" : [ "password", "token", "username" ]
      },
      "JellyfinConnectionResponse" : {
        "type" : "object",
        "properties" : {
          "url" : {
            "type" : [ "string", "null" ]
          }
        }
      },
      "Session" : {
        "type" : "object",
        "properties" : {
          "username" : {
            "type" : "string"
          }
        },
        "required" : [ "username" ]
      },
      "SetupStatus" : {
        "type" : "object",
        "properties" : {
          "required" : {
            "type" : "boolean"
          }
        },
        "required" : [ "required" ]
      }
    }
  }
