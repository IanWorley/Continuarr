    },
    "/api/csrf" : {
      "get" : {
        "tags" : [ "csrf-controller" ],
        "operationId" : "csrf",
        "responses" : {
          "204" : {
            "description" : "No Content"
          }
        }
      }
    }
  },
  "components" : {
