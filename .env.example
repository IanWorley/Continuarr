# Copy to .env and fill in. .env is gitignored; never commit real values.

POSTGRES_DB=continuarr
POSTGRES_USER=continuarr
POSTGRES_PASSWORD=change-me

# No admin credentials here: on first start the app logs a one-time setup token
# (`docker compose logs app`), which POST /api/setup uses to create the admin.

# Host port for the app.
CONTINUARR_PORT=8080

# Encrypts the Jellyfin API key you save in the app. Left blank, the app creates a key in the
# continuarr-data volume on first start and reuses it after that. Back that volume up with your
# database backups: a saved key can't be read without it. To use your own key instead, set one
# from `openssl rand -hex 32`. A key set here always wins over the generated one.
CONTINUARR_ENCRYPTION_KEY=
