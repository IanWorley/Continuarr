            "type" : "string"
          },
          "apiKey" : {
            "type" : "string"
          }
        },
        "required" : [ "apiKey", "url" ]
      },
      "JellyfinConnectionProblem" : {
        "type" : "object",
        "properties" : {
          "invalidFields" : {
            "type" : "array",
            "items" : {
              "type" : "string",
              "enum" : [ "URL", "API_KEY" ]
            }
          }
        },
        "required" : [ "invalidFields" ]
      },
      "SetupRequest" : {
        "type" : "object",
