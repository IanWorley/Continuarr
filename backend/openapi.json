{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "OpenAPI definition",
    "version" : "v0"
  },
  "servers" : [ {
    "url" : "http://localhost",
    "description" : "Generated server url"
  } ],
  "paths" : {
    "/api/v1/jellyfin/connection" : {
      "get" : {
        "tags" : [ "jellyfin-connection-controller" ],
        "operationId" : "connection",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/JellyfinConnectionResponse"
                }
              }
            }
          }
        }
      },
      "put" : {
        "tags" : [ "jellyfin-connection-controller" ],
        "operationId" : "save",
